          }
        ]
      ]
    },
    "Filter Active High-View Channels": {
      "main": [
        [
          {
            "node": "Deduplicate by Channel ID",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Deduplicate by Channel ID": {
      "main": [
        [
          {
